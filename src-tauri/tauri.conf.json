{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AllTheThings",
  "version": "0.14.0",
  "identifier": "co.swatto.allthethings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AllTheThings",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#1d232a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Swatto",
    "copyright": "© 2026 Swatto",
    "license": "MIT",
    "homepage": "https://github.com/Swatto86/AllTheThings",
    "category": "Utility",
    "shortDescription": "Instant filename search for Windows",
    "longDescription": "AllTheThings — a voidtools Everything clone. Instant filename search across all NTFS volumes via the Master File Table, kept live with the USN change journal.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Swatto86/AllTheThings/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyMzlGMTc0NDgwNTVBRjUKUldUMVdnVklkUEU1a3ZTNkY1eFFUb25JSlRDc1dadHJNOHArMzQ0d0kyTENOWEVjeGNoaHlkVDUK"
    }
  }
}
